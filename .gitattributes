# Normalize line endings so Windows, Mac and Linux teammates don't fight over them
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.woff binary
*.woff2 binary

# Lockfile: treat as generated, avoid noisy diffs
package-lock.json linguist-generated=true -diff
