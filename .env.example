# Copy to .env.local and fill in. NEVER commit .env.local.

# ElevenLabs (Agents → your agent → copy the agent ID; API key from profile → API keys)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Supabase (optional locally, required on Vercel). Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: protects DELETE /api/events (reset the feed before a demo run)
DEMO_RESET_TOKEN=
