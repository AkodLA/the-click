# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# .env.local is git-ignored. NEVER commit real keys. Keys are shared by Discord DM only.
# None of these may start with NEXT_PUBLIC_ (that would send them to the browser).

# Signs learner progress so it can't be faked. REQUIRED on Vercel (local dev uses a dev-only fallback).
# Generate one:  openssl rand -base64 32
PROGRESS_SECRET=

# ElevenLabs: key from the account that owns the agents. Server-side only.
# Give the key limited permissions and a credit limit in the ElevenLabs dashboard.
ELEVENLABS_API_KEY=
ELEVENLABS_TUTOR_AGENT_ID=
ELEVENLABS_TOLK_AGENT_ID=
# T23 "Say it in Norwegian" text agent (optional; created by npm run agents:sync -- message)
ELEVENLABS_MESSAGE_AGENT_ID=

# Partner API keys (hashes only). Create with:  npm run partner:key -- <partner-id> <scope>
# Format: partnerId:scope|scope:sha256hex, comma-separated. See docs/PARTNER-API.md
PARTNER_KEYS=
