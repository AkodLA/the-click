# Copy to .env.local and fill in. NEVER commit .env.local.

# ElevenLabs API key (profile → API keys)
ELEVENLABS_API_KEY=

# One agent per voice feature (Agents → your agent → copy the ID)
ELEVENLABS_TUTOR_AGENT_ID=   # /snakk  – speaking tutor  (agent/tutor)
ELEVENLABS_TOLK_AGENT_ID=    # /tolk   – interpreter     (agent/tolk)
ELEVENLABS_AGENT_ID=         # /lager  – warehouse assistant (agent/lager)

# Supabase (optional locally, required on Vercel for the /leder feed). Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: protects DELETE /api/events (reset the feed before a demo run)
DEMO_RESET_TOKEN=
